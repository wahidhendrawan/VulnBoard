generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Tenant {
  id               String            @id @default(cuid())
  slug             String            @unique
  name             String
  createdAt        DateTime          @default(now())
  users            User[]
  engagements      Engagement[]
  findings         Finding[]
  findingTemplates FindingTemplate[]
  reports          Report[]
  auditLogs        AuditLog[]
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  password     String
  name         String
  company      String?
  tenantId     String     @default("default")
  tenant       Tenant     @relation(fields: [tenantId], references: [id])
  roles        String     @default("[\"viewer\"]")
  authProvider String     @default("local")
  oidcIssuer   String?
  oidcSubject  String?
  createdAt    DateTime   @default(now())
  engagements  Engagement[]
  auditLogs    AuditLog[]

  @@unique([oidcIssuer, oidcSubject])
  @@index([tenantId])
}

model Engagement {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  tenantId    String    @default("default")
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  clientName  String
  projectName String
  scope       String
  testingType String
  methodology String
  frameworkId String
  templateId  String
  language    String    @default("en")
  logoUrl     String?
  brandColor  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  findings    Finding[]
  reports     Report[]

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
}

model Finding {
  id             String     @id @default(cuid())
  engagementId   String
  engagement     Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  tenantId       String     @default("default")
  tenant         Tenant     @relation(fields: [tenantId], references: [id])
  title          String
  severity       String
  controlId      String?
  description    String?
  impact         String?
  evidence       String?
  recommendation String?
  createdAt      DateTime   @default(now())

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([engagementId])
}

model FindingTemplate {
  id             String    @id @default(cuid())
  tenantId       String?
  tenant         Tenant?   @relation(fields: [tenantId], references: [id])
  title          String
  severity       String
  controlId      String?
  description    String
  impact         String
  recommendation String
  category       String?
  language       String    @default("en")
  createdAt      DateTime  @default(now())

  @@index([tenantId, language, category])
  @@index([language, category])
}

model Report {
  id           String     @id @default(cuid())
  engagementId String
  engagement   Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  tenantId     String     @default("default")
  tenant       Tenant     @relation(fields: [tenantId], references: [id])
  markdown     String
  pdfPath      String?
  createdAt    DateTime   @default(now())

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([engagementId])
}

model AuditLog {
  id            String   @id @default(cuid())
  actorId       String?
  actor         User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorSub      String
  actorEmail    String?
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  action        String
  resourceType  String?
  resourceId    String?
  status        String
  ipAddress     String?
  userAgent     String?
  metadata      String?
  createdAt     DateTime @default(now())

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([actorSub, createdAt(sort: Desc)])
}
